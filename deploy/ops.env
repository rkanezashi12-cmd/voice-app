# GitHub Actions（.github/workflows/ops.yml）が使う GCP の値。秘密情報ではない（鍵ファイルは使わない）。
# 作るのは scripts/setup_github_actions.sh（Cloud Shell で1回）。値が違うと、そのスクリプトが正しい値を出す。
GCP_PROJECT_ID=voice-ai-510014
REGION=asia-northeast1
SERVICE=meeting-notes
WIF_PROVIDER=projects/943049502425/locations/global/workloadIdentityPools/github/providers/github
DEPLOYER_SA=meeting-notes-deployer@voice-ai-510014.iam.gserviceaccount.com
IMAGE_REPO=asia-northeast1-docker.pkg.dev/voice-ai-510014/cloud-run-source-deploy/meeting-notes
